  {
    "name": "attribute-scope",
    "routes": [
      {
        "path": "/fabrication",
        "body": {
          "job": "j1",
          "layers": [
            {
              "id": "top",
              "href": "/layer/top"
            }
          ]
        },
        "status": 200,
        "method": "GET"
      },
      {
        "path": "/layer/top",
        "body": [
          {
            "op": "format",
            "integer": 2,
            "decimal": 4,
            "zeroSuppression": "leading"
          },
          {
            "op": "unit",
            "value": "mm"
          },
          {
            "op": "aperture",
            "id": "10",
            "shape": "C",
            "params": [
              "0.5"
            ]
          },
          {
            "op": "select",
            "id": "10"
          },
          {
            "op": "attribute",
            "scope": "object",
            "key": "net",
            "value": "GND"
          },
          {
            "op": "flash",
            "x": "10000",
            "y": "20000",
            "byteStart": 80,
            "byteEnd": 95
          },
          {
            "op": "deleteAttribute",
            "scope": "object",
            "key": "*"
          },
          {
            "op": "flash",
            "x": "30000",
            "byteStart": 100,
            "byteEnd": 112
          }
        ],
        "status": 200,
        "method": "GET"
      }
    ],
    "expected": [
      {
        "kind": "flash",
        "position": [
          1,
          2
        ],
        "aperture": "10",
        "attributes": {
          "net": "GND"
        }
      },
      {
        "kind": "flash",
        "position": [
          3,
          2
        ],
        "attributes": {}
      }
    ],
    "forbidden": []
  },
